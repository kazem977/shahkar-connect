# Release builds. Replace the host with the live panel after cutover.
# Do not ship a debug build with this file until native_app_api is enabled.
#
#   flutter build apk --dart-define-from-file=env/prod.env.example
#
# Never put webhook secrets or store API keys in the Flutter client.

SHAHKAR_API_BASE=https://panel.example.com
SHAHKAR_ENV=prod
