# Local / debug Flutter builds.
# Point at a staging or lab panel — not production — until native_app_api is on.
#
#   flutter run --dart-define-from-file=env/dev.env.example
#   flutter run --dart-define=SHAHKAR_API_BASE=https://staging.example.com
#
# Feature flag native_app_api must be ON on that panel or /api/v1 returns 404.

SHAHKAR_API_BASE=https://staging.example.com
SHAHKAR_ENV=dev
